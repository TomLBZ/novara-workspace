#!/usr/bin/env bash
# shellcheck shell=bash
# ---------------------------------------------------------------------------
# <workspace>/bin/ws-gateway
#
# Control the workspace's long-running services.  Every service is defined in
# services/services.json (see services.example.json for the tracked baseline -
# that file is the single source of service truth: script, ports, health path,
# log, the router's route table and each service's settings).  Credentials and
# LLM settings live in config.yaml, never here.
#
#   ws-gateway status                 services + the resolved route table
#   ws-gateway validate               check services.json (exit 3 = problems)
#   ws-gateway start|stop|restart [SERVICE ...]
#   ws-gateway ensure                 start whatever is down, silent when all is well
#   ws-gateway routes                 print the resolved route table
#   ws-gateway logs [SERVICE] [N]     tail a service log (default: gateway)
#
# Every service implements `--healthz PORT`; `ensure` is what the per-minute cron
# watchdog calls, so a container rebuilt from a new image comes back by itself.
# ---------------------------------------------------------------------------
set -euo pipefail

_ws_self="${BASH_SOURCE[0]:-$0}"
WS_ROOT="$(cd -P "$(dirname "$_ws_self")/.." && pwd)"
MANIFEST="$WS_ROOT/services/services.json"
RUN_DIR="$WS_ROOT/runtime/run"
mkdir -p "$RUN_DIR" "$WS_ROOT/logs"

# First run on a fresh clone: the live manifest is machine state (gitignored, like
# config.yaml); it bootstraps from the tracked example, which the environment alone can serve.
[ -f "$MANIFEST" ] || cp "$WS_ROOT/services/services.example.json" "$MANIFEST"

PY="$WS_ROOT/venvs/py/bin/python"
[ -x "$PY" ] || PY="$(command -v python3 || command -v python)"

_sm() { WS_ROOT="$WS_ROOT" "$PY" "$WS_ROOT/tools/servicemanifest.py" --root "$WS_ROOT" "$@"; }

manifest_problems() { # 0 = valid, prints the reasons otherwise
  local out
  if ! out="$(_sm validate 2>&1)"; then
    printf '%s\n' "$out" >&2
    return 1
  fi
  return 0
}

_services() { _sm services; }
script_of() { echo "$WS_ROOT/$(_sm script "$1")"; }
ports_of()  { _sm ports "$1"; }
log_of()    { echo "$WS_ROOT/$(_sm log "$1")"; }
pid_file()  { echo "$RUN_DIR/$1.pid"; }

alive() {
  local f; f="$(pid_file "$1")"
  [ -f "$f" ] && kill -0 "$(cat "$f")" 2>/dev/null
}

healthy() { # any port answering the health path counts as healthy
  local svc="$1" p
  for p in $(ports_of "$svc"); do
    WS_PID_FILE="$(pid_file "$svc")" "$PY" "$(script_of "$svc")" --healthz "$p" 2>/dev/null && return 0
  done
  return 1
}

installed() { [ -f "$(script_of "$1")" ]; }

start_one() {
  local svc="$1" log
  log="$(log_of "$svc")"
  installed "$svc" || { echo "$svc: not installed ($(script_of "$svc"))" >&2; return 1; }
  if healthy "$svc"; then echo "$svc: already healthy"; return 0; fi
  alive "$svc" && { echo "$svc: up but not answering - restarting"; stop_one "$svc" >/dev/null; }
  mkdir -p "$(dirname "$log")"
  echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') ws-gateway: starting $svc ports: $(ports_of "$svc")" >>"$log"
  WS_ROOT="$WS_ROOT" WS_MANIFEST="$MANIFEST" WS_SERVICE="$svc" WS_PID_FILE="$(pid_file "$svc")" \
    setsid nohup "$PY" "$(script_of "$svc")" >>"$log" 2>&1 </dev/null &
  for _ in $(seq 1 30); do
    sleep 0.2
    healthy "$svc" && { echo "$svc: up (pid $(cat "$(pid_file "$svc")" 2>/dev/null))"; return 0; }
  done
  echo "$svc: FAILED to come up - see $log" >&2
  return 1
}

stop_one() {
  local svc="$1" pid
  if alive "$svc"; then
    pid="$(cat "$(pid_file "$svc")")"
    kill "$pid" 2>/dev/null || true
    for _ in $(seq 1 25); do kill -0 "$pid" 2>/dev/null || break; sleep 0.2; done
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
    rm -f "$(pid_file "$svc")"
    echo "$svc: stopped ($pid)"
  else
    rm -f "$(pid_file "$svc")"
    echo "$svc: not running"
  fi
}

ensure() { # silent while healthy: this is the cron watchdog entry point
  manifest_problems || return 1
  local svc
  for svc in $(_services); do
    installed "$svc" || continue          # a project repo that is not cloned here is not an error
    healthy "$svc" || start_one "$svc" | sed 's/^/ws-gateway: /'
  done
  return 0
}

status() {
  manifest_problems || return 1
  local svc pid state
  printf '%-10s %-8s %-11s %-6s %s\n' SERVICE PID PORTS HEALTH LOG
  for svc in $(_services); do
    if alive "$svc"; then pid="$(cat "$(pid_file "$svc")")"; else pid="-"; fi
    if ! installed "$svc"; then state="absent"; else healthy "$svc" && state="up" || state="DOWN"; fi
    printf '%-10s %-8s %-11s %-6s %s\n' "$svc" "$pid" "$(ports_of "$svc" | tr ' ' ',')" \
      "$state" "$(log_of "$svc")"
  done
  echo
  echo "MANIFEST (services/services.json - services, ports, routes, settings)"
  echo "  validated: OK"
  echo
  echo "ROUTES (resolved; a proxy route names its target service)"
  _sm routes | "$PY" -c '
import json, signal, sys
signal.signal(signal.SIGPIPE, signal.SIG_DFL)
for r in json.load(sys.stdin):
    print("  %-18s %-6s %s" % (r.get("prefix"), r.get("type"),
                               r.get("root") or r.get("upstream")))
'
}

case "${1:-status}" in
  start|stop|restart)
    verb="$1"; shift || true
    manifest_problems || exit 3
    targets=("$@"); [ ${#targets[@]} -eq 0 ] && targets=($(_services))
    for s in "${targets[@]}"; do
      case "$verb" in
        start)   start_one "$s" ;;
        stop)    stop_one "$s" ;;
        restart) stop_one "$s" >/dev/null; start_one "$s" ;;
      esac
    done ;;
  ensure)   ensure ;;
  status)   status ;;
  validate) _sm validate ;;
  routes)   _sm routes ;;
  logs)     tail -n "${3:-40}" "$(log_of "${2:-gateway}")" ;;
  *) echo "usage: ws-gateway {status|validate|start|stop|restart|ensure|routes|logs [SERVICE] [N]}" >&2; exit 2 ;;
esac
