{
  "_comment": "Route schema for ws-gateway. Longest prefix wins; /healthz is reserved by the router.",
  "listen": [
    80,
    8081
  ],
  "routes": [
    {
      "prefix": "/projects/hello",
      "type": "static",
      "root": "services/sites/hello"
    },
    {
      "prefix": "/dash",
      "type": "proxy",
      "upstream": "http://127.0.0.1:30533",
      "strip_prefix": true
    },
    {
      "prefix": "/",
      "type": "proxy",
      "upstream": "http://127.0.0.1:8090",
      "strip_prefix": false
    }
  ]
}
